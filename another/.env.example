# =============================================================================
# Another VPN — .env.example
# =============================================================================
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
#
# ВАЖНО: .env — ТОЛЬКО для локальной разработки. В production переменные
# окружения должны задаваться реальным секрет-менеджером (Cloudflare Secrets
# Store для edge/, systemd EnvironmentFile / Docker secrets / CI secrets для
# остальных компонентов) — см. §11, §15 спецификации (docs/architecture.md).
# Никогда не коммитьте настоящий .env в git (см. .gitignore).
#
# МОНОРЕПОЗИТОРИЙ: another живёт внутри cutaway и на HF Space читает окружение
# самого Space, а не этот файл. Что именно задавать в секретах HF/GitHub и в
# каком порядке — см. another/DEPLOY.md. Здесь остаются значения для локальной
# разработки. На HF `MONGO_URI` не задаётся: плагин переиспользует общий секрет
# кластера `MONGODB_URI` (another/main.py).
# =============================================================================


# --- MongoDB Atlas (источник истины, §10 спецификации) --------------------
# Формат: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# ЗАГЛУШКА — заменить на реальную строку подключения к вашему M0/M10+ кластеру.
MONGO_URI=mongodb+srv://another_user:CHANGE_ME@another-cluster.xxxxx.mongodb.net/another?retryWrites=true&w=majority
MONGO_DB_NAME=another


# --- Go Core (core/) --------------------------------------------------------
ANOTHER_CLIENT_ID=dev-device
ANOTHER_KEYSTORE_DIR=./.another/keystore
ANOTHER_CONTROL_PLANE_URL=http://127.0.0.1:8787
ANOTHER_LOCAL_API_ADDR=127.0.0.1:47821
# Точки входа Tier1 (см. §3 спецификации) — заглушки, заменить на реальные
# после деплоя edge/ (Part 2) и Render-резерва.
ANOTHER_NODE_CF_HOST=cf-worker.another.example
ANOTHER_NODE_RENDER_HOST=another-backup.onrender.com


# --- Edge / Cloudflare Worker (edge/, Part 2) -------------------------------
# Получить в Cloudflare Dashboard → My Profile → API Tokens.
# Права: Zone.DNS (Edit), Zone.Zone Settings (Edit) — для отключения ECH (§9.3).
CLOUDFLARE_API_TOKEN=CHANGE_ME_cf_api_token
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME_account_id
CLOUDFLARE_ZONE_ID=CHANGE_ME_zone_id
# MongoDB Atlas Data API (EOL 2025-09-30) — НЕ использовать.
# Worker ходит в Mongo только через наш REST-прокси (HF/Render), см.
# docs/adr/0005-mongo-rest-proxy.md и docs/infrastructure.md.
# MONGO_DATA_API_URL=
# MONGO_DATA_API_KEY=
# URL внутреннего прокси / origin API (секрет сервиса, не пользовательский):
MONGO_REST_PROXY_URL=http://127.0.0.1:8080
ANOTHER_SERVICE_SECRET=CHANGE_ME_service_secret
# Worker, куда origin дергает POST /internal/ban-invalidate после revoke.
# Пусто = инвалидация KV только по TTL 30с.
EDGE_INTERNAL_URL=http://127.0.0.1:8787
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8080
EVENTS_CAPPED_SIZE_BYTES=67108864


# --- Render (резервный узел Tier1) ------------------------------------------
RENDER_SERVICE_URL=https://another-backup.onrender.com
RENDER_PING_INTERVAL_MINUTES=14


# --- Control-plane admin (control-plane-admin/, Part 3) ---------------------
# Telegram-бот снят со скоупа релиза (docs/adr/0003-web-admin-pq-auth.md).
# Переменные оставлены, пока код бота живёт в дереве.
TELEGRAM_BOT_TOKEN=CHANGE_ME_telegram_bot_token
TELEGRAM_ADMIN_IDS=123456789,987654321
ADMIN_CLI_MONGO_URI=${MONGO_URI}


# --- Общие флаги окружения ---------------------------------------------------
ANOTHER_ALLOW_NOOP_TUN=1
# 1 = не открывать Wintun/nft (dev без админа). Пусто = пытаться настоящий TUN.
ANOTHER_TUN_IF=another0
ANOTHER_XHTTP_ADDR=127.0.0.1:8081
ANOTHER_RUN_XHTTP=0
ANOTHER_RUN_REALITY=0
ANOTHER_REALITY_LISTEN=127.0.0.1:8443
ANOTHER_REALITY_DEST=
ANOTHER_REALITY_PRIVATE_KEY=
ANOTHER_REALITY_SHORT_IDS=
ANOTHER_REALITY_SERVER_NAMES=
ANOTHER_NODE_HF_HOST=CHANGE_ME.hf.space
ANOTHER_ENROLLMENT_TOKEN=
ANOTHER_NODES_JSON=[]
# 1 = origin API реально вызывает go build при op build_installer
ANOTHER_BUILD_ENABLED=
ANOTHER_CORE_DIR=
ANOTHER_BUILD_DIR=
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
ANOTHER_INSTALLER_EVENT=another-installer
# 1 = Worker шлёт сырой IP в sessions upsert (режим расследования)
ANOTHER_INVESTIGATION=
ANOTHER_ENV=development
# development | staging | production — см. §15 спецификации: отдельные
# Atlas-проекты/Cloudflare-зоны на каждое окружение (ограничение free tier:
# один M0-кластер на проект).
LOG_LEVEL=info
