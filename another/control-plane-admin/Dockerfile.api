# syntax=docker/dockerfile:1
#
# Origin control-plane: Mongo REST-прокси для Worker + admin API + Web-монитор.
# Тонкий образ только API. Тот же процесс для HF и Render.
# Образ API+xHTTP sidecar: ../deploy/origin/Dockerfile

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY another_admin/ ./another_admin/

RUN useradd --create-home --uid 10001 apiuser
USER apiuser

ENV PYTHONPATH=/app
ENV ADMIN_API_HOST=0.0.0.0
ENV ADMIN_API_PORT=8080

EXPOSE 8080

CMD ["python", "-m", "another_admin.api"]
