#cloud-config
hostname: ${hostname}
package_update: true
packages:
  - docker.io
  - docker-compose-v2
write_files:
  - path: /opt/another/docker-compose.yml
    permissions: "0644"
    content: |
      services:
        origin:
          image: ${origin_image}
          ports:
            - "8080:8080"
            - "8081:8081"
            - "443:8443"
          environment:
            MONGO_URI: "${mongo_uri}"
            MONGO_DB_NAME: another
            ANOTHER_SERVICE_SECRET: "${service_secret}"
            ANOTHER_CONTROL_PLANE_URL: "${control_plane_url}"
            ANOTHER_RUN_XHTTP: "${run_xhttp}"
            ANOTHER_RUN_REALITY: "${run_reality}"
            ANOTHER_REALITY_DEST: "${reality_dest}"
            ANOTHER_REALITY_SERVER_NAMES: "${reality_server_names}"
            ANOTHER_REALITY_SHORT_IDS: "${reality_short_ids}"
            ANOTHER_REALITY_PRIVATE_KEY: "${reality_private_key}"
            ANOTHER_REALITY_LISTEN: "0.0.0.0:8443"
            ADMIN_API_HOST: 0.0.0.0
            ADMIN_API_PORT: "8080"
          restart: unless-stopped
runcmd:
  - [ sh, -c, "cd /opt/another && docker compose up -d" ]
